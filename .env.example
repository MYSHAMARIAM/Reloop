# Reloop Environment Configuration
# ====================================================

# Frontend Environment Variables
# The URL where FastAPI backend is accessible from the browser
VITE_API_URL="http://127.0.0.1:8000/api"

# Backend Environment Variables
ENVIRONMENT="development"
DEBUG="True"
ALLOW_DEMO_DURATIONS="True"
DATABASE_URL="sqlite:///data/reloop.db"
SESSION_SECRET_KEY="reloop-secure-random-college-secret-key-change-in-production"
COOKIE_SECURE="False"

